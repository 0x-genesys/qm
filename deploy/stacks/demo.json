{
  "contract": 1,
  "orgId": "demo",
  "publicUrl": "https://demo-agent.example.com",
  "target": "docker",
  "services": ["core", "web-ui", "portal"],
  "env": {
    "core": {
      "WEB_UI_PUBLIC_URL": "https://demo-agent.example.com/web-ui",
      "PUBLIC_WEB_URL": "https://demo-agent.example.com",
      "S3_BUCKET": "demo-agent-data",
      "S3_REGION": "auto"
    },
    "web-ui": {
      "WEB_UI_PUBLIC_URL": "https://demo-agent.example.com/web-ui"
    },
    "portal": {
      "PORTAL_PUBLIC_URL": "https://demo-agent.example.com",
      "OIDC_ALLOWED_EMAIL_DOMAIN": "example.com",
      "PORTAL_EXPECTED_TEAM_ID": "T00000000"
    }
  }
}
